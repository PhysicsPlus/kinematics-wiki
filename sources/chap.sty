% -----------------------------------------------------------------------
% 19. TikZ / PGFPlots — стили рисунков (общие с задачником Physics-Problems)
% Источник: sty/tikz-preamble.sty и sty/physprobs.sty задачника. Назначение —
% чтобы рисунки лекций были оформлены один в один с задачником.
% -----------------------------------------------------------------------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, angles, quotes, calc, positioning, backgrounds}

\tikzset{
  thin/.style     = {line width=0.5pt},
  standart/.style = {line width=0.75pt},
  thick/.style    = {line width=1pt},
  heavy/.style    = {line width=1.4pt},
}

\tikzset{
  % Стрелка-вектор: Stealth, 0.75 pt (скорости, силы, оси-стрелки)
  myarrow/.style = {
    -{Stealth[inset=0pt, length=8pt, angle'=30]},
    line width=0.75pt
  },
  % Точка-кружок: диаметр 1 мм, белая заливка, обводка 0.5 pt
  point/.style = {
    draw=black, fill=white, line width=0.5pt,
    circle, minimum width=1mm, minimum height=1mm, inner sep=0pt
  },
  probpoint/.style = {
    draw=black, fill=white, line width=0.5pt,
    circle, minimum size=1mm, inner sep=0pt
  },
  every node/.style={font=\small}
}

\RequirePackage{pgfplots}
\pgfplotsset{
  compat=1.18,
  % compact — оси-стрелки, без сетки (схемы, траектории, простые зависимости)
  compact/.style={
    width=0.95\linewidth, height=6cm,
    axis lines=left,
    axis line style={-{Latex}},
    xlabel style={at={(axis description cs:1,0)}, anchor=north west,
      xshift=3pt, inner sep=1pt},
    ylabel style={at={(axis description cs:0,1)}, anchor=south east,
      yshift=2pt, rotate=0, inner sep=1pt},
    tick label style={font=\small}, label style={font=\small},
    grid=none, enlargelimits=false, clip=false,
  },
  % olymp-grid — рамка с двухуровневой сеткой-миллиметровкой
  olymp-grid/.style={
    axis lines=box,
    axis line style={standart, black},
    grid=both,
    major grid style={standart, black},
    minor grid style={thin, gray},
    tick style={draw=none},
    xlabel style={at={(xticklabel* cs:1)}, anchor=north east,
      xshift=3pt, yshift=-1pt, font=\small},
    ylabel style={at={(yticklabel* cs:1)}, anchor=south east,
      rotate=-90, yshift=-15pt, xshift=-1pt, font=\small},
    enlargelimits=false, clip=false,
  },
  % arrowaxes — схематичные оси-стрелки через начало координат, метки вручную
  arrowaxes/.style={
    axis lines=middle,
    axis line style={myarrow},
    enlargelimits=false, clip=false, grid=none, scale only axis,
    xtick=\empty, ytick=\empty,
    tick label style={font=\small}, label style={font=\small},
  },
  compact
}

% \mmgrid — сетка-миллиметровка внутри axis (olymp-grid + grid=none), вызывать
% ДО \addplot. \mmgrid[стиль мелк.][стиль осн.]{xmin}{xmax}{ymin}{ymax}{шаг м.}{шаг о.}
\NewDocumentCommand{\mmgrid}{ O{thin,black!30} O{thin,black!80} m m m m m m }{%
  \pgfmathtruncatemacro{\PP@gnx}{round((#4-#3)/#7)}%
  \pgfmathtruncatemacro{\PP@gny}{round((#6-#5)/#7)}%
  \pgfmathtruncatemacro{\PP@gNx}{round((#4-#3)/#8)}%
  \pgfmathtruncatemacro{\PP@gNy}{round((#6-#5)/#8)}%
  \foreach \PP@i in {0,...,\PP@gnx}{%
    \pgfmathparse{#3+\PP@i*#7}\edef\PP@g{\pgfmathresult}%
    \edef\PP@d{\noexpand\draw[#1] (axis cs:\PP@g,#5) -- (axis cs:\PP@g,#6);}\PP@d}%
  \foreach \PP@i in {0,...,\PP@gny}{%
    \pgfmathparse{#5+\PP@i*#7}\edef\PP@g{\pgfmathresult}%
    \edef\PP@d{\noexpand\draw[#1] (axis cs:#3,\PP@g) -- (axis cs:#4,\PP@g);}\PP@d}%
  \foreach \PP@i in {0,...,\PP@gNx}{%
    \pgfmathparse{#3+\PP@i*#8}\edef\PP@g{\pgfmathresult}%
    \edef\PP@d{\noexpand\draw[#2] (axis cs:\PP@g,#5) -- (axis cs:\PP@g,#6);}\PP@d}%
  \foreach \PP@i in {0,...,\PP@gNy}{%
    \pgfmathparse{#5+\PP@i*#8}\edef\PP@g{\pgfmathresult}%
    \edef\PP@d{\noexpand\draw[#2] (axis cs:#3,\PP@g) -- (axis cs:#4,\PP@g);}\PP@d}%
}

