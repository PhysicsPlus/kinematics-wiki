% Лодка держит курс на точку O противоположного берега; скорость лодки относительно воды
% равна скорости течения. Траектория -- парабола r + x = d с фокусом O и директрисой l (x = d).
% d = 3; C -- текущее положение лодки (y = 1,5); P -- точка, к которой приближается лодка.
\begin{tikzpicture}[scale=1.25]
  \def\d{3}
  \coordinate (A) at (0,0);
  \coordinate (O) at (0,\d);
  \coordinate (C) at (1.125,1.5);
  \coordinate (D) at (\d,1.5);
  \coordinate (P) at (1.5,\d);
  \begin{scope}
    \clip (-1.2,-0.18) rectangle (3.6,0);
    \foreach \x in {-1.2,-1.025,...,3.955} \draw[thin] (\x,0) -- ++(-0.18,-0.18);
  \end{scope}
  \begin{scope}
    \clip (-1.2,3) rectangle (3.6,3.18);
    \foreach \x in {-1.38,-1.205,...,3.775} \draw[thin] (\x,3) -- ++(0.18,0.18);
  \end{scope}
  \draw[standart] (-1.2,0) -- (3.6,0);
  \draw[standart] (-1.2,\d) -- (3.6,\d);
  \draw[thin, dashed] (\d,-0.3) -- (\d,\d+0.3) node[above right] {$l$};
  \draw[thick] plot[domain=0:2.97, samples=60, smooth, variable=\y] ({\y*(2*\d-\y)/(2*\d)}, \y);
  \draw[thin] (C) -- node[below left] {$r$} (O);
  \draw[thin, dashed] (C) -- (D);
  \draw[thin] ($(D)+(-0.16,0)$) -- ++(0,0.16) -- ++(0.16,0);
  \draw[myarrow] (-0.9,1.5) -- (-0.1,1.5) node[above] {$v$};
  \node[point] at (A) {};
  \node[point] at (O) {};
  \node[point] at (C) {};
  \node[point] at (P) {};
  \node[above left] at (A) {$A$};
  \node[below left] at (O) {$O$};
  \node[below right] at (C) {$C$};
  \node[below right] at (P) {$P$};
  \node[below left] at (D) {$D$};
\end{tikzpicture}
