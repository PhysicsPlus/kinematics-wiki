% Контрабандисты и катер: судно уходит из A перпендикулярно берегу, катер из B
% держит курс на судно; u/v = (1+sqrt5)/2, поимка в точке C на расстоянии L от берега.
% L = 3. Кривая погони рассчитана численно; P, Q -- одновременные положения катера и судна.
\begin{tikzpicture}[scale=1.5]
  \coordinate (A) at (0,0);
  \coordinate (B) at (3,0);
  \coordinate (C) at (0,3);
  \coordinate (P) at (1.357,0.357);
  \coordinate (Q) at (0,1.049);
  \begin{scope}
    \clip (-1.1,-0.135) rectangle (3.5,0);
    \foreach \x in {-1.1,-0.93,...,3.805} \draw[thin] (\x,0) -- ++(-0.135,-0.135);
  \end{scope}
  \draw[standart] (-1.1,0) -- (3.5,0);
  \draw[thin] (A) -- (C);
  \draw[thick] plot[smooth] coordinates {(3.000,0.000) (2.838,0.003) (2.677,0.011) (2.516,0.026) (2.355,0.046) (2.196,0.074) (2.038,0.108) (1.881,0.150) (1.727,0.199) (1.576,0.256) (1.428,0.322) (1.284,0.395) (1.144,0.477) (1.010,0.568) (0.882,0.667) (0.762,0.775) (0.648,0.890) (0.544,1.013) (0.448,1.144) (0.361,1.281) (0.285,1.423) (0.218,1.570) (0.161,1.722) (0.114,1.877) (0.077,2.034) (0.048,2.193) (0.027,2.354) (0.013,2.515) (0.004,2.676) (0.001,2.838) (0.000,2.995)};
  \draw[thin] (P) -- node[below left=-1pt, pos=0.74] {$r$} (Q);
  \draw[thin, dashed] (P) -- (0,0.357);
  \draw[myarrow] (Q) -- ++(0,0.6);
  \node[left=1pt] at ($(Q)+(0,0.6)!1.4mm!(Q)$) {$\mbfv$};
  \coordinate (U) at ($(P)!1.0cm!(Q)$);
  \draw[myarrow] (P) -- (U);
  \node[below left=0pt] at ($(U)!1.4mm!(P)$) {$\mbfu$};
  \draw[thin] (0,0.357) -- (-0.45,0.357);
  \draw[thin] (Q) -- (-0.45,1.049);
  \draw[{Stealth[inset=0pt, length=8pt, angle'=30]}-{Stealth[inset=0pt, length=8pt, angle'=30]}, line width=0.75pt] (-0.35,0.357) -- node[left] {$x$} (-0.35,1.049);
  \draw[thin] (C) -- (-1.0,3);
  \draw[{Stealth[inset=0pt, length=8pt, angle'=30]}-{Stealth[inset=0pt, length=8pt, angle'=30]}, line width=0.75pt] (-0.9,0) -- node[left] {$L$} (-0.9,3);
  \draw[thin] (B) -- (3,-0.62);
  \draw[thin] (A) -- (0,-0.62);
  \draw[{Stealth[inset=0pt, length=8pt, angle'=30]}-{Stealth[inset=0pt, length=8pt, angle'=30]}, line width=0.75pt] (0,-0.52) -- node[above] {$L$} (3,-0.52);
  \node[point] at (A) {};
  \node[point] at (B) {};
  \node[point] at (C) {};
  \node[point] at (P) {};
  \node[point] at (Q) {};
  \node[above right] at (A) {$A$};
  \node[above right] at (B) {$B$};
  \node[right] at (C) {$C$};
  \node[above right=0pt] at (P) {$P$};
  \node[right=2pt, yshift=2pt] at (Q) {$Q$};
\end{tikzpicture}
