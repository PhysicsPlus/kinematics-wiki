% Лиса бежит под углом alpha к направлению на зайца (угол отсчитан против часовой стрелки)
\begin{tikzpicture}[scale=1]
  \coordinate (F) at (0,0);
  \coordinate (H) at (0,2.6);
  \coordinate (U) at (120:1.4);
  \draw[thin, dashed] (F) -- node[right] {$L$} (H);
  \draw[myarrow] (H) -- ++(1.2,0) node[above] {$\mbfv$};
  \draw[myarrow] (F) -- (U) node[left] {$\mbfu$};
  \pic[draw, thin, pic text={$\alpha$}, angle radius=8mm, angle eccentricity=1.35] {angle = H--F--U};
  \node[point] at (F) {};
  \node[point] at (H) {};
  \node[below] at (F) {Лиса};
  \node[above left] at (H) {Заяц};
\end{tikzpicture}
