% Четыре черепахи в вершинах квадрата: траектории -- логарифмические спирали R = R_0 e^{-phi}
\begin{tikzpicture}[scale=1]
  \def\Rz{1.8}
  \draw[thin] (45:\Rz) -- (-45:\Rz) -- (-135:\Rz) -- (135:\Rz) -- cycle;
  \foreach \s in {45,135,225,315}{
    \draw[thick] plot[domain=0:600, samples=240, smooth, variable=\t]
      ({\s-\t}:{\Rz*exp(-\t*pi/180)});
    \draw[myarrow] (\s:\Rz) -- ($(\s:\Rz)!0.3!(\s-90:\Rz)$);
    \node[point] at (\s:\Rz) {};
  }
  \node[point] at (0,0) {};
  \node[below right=3pt, fill=white, inner sep=1pt] at (0,0) {$O$};
  \node[above right] at (45:\Rz) {$B_1$};
  \node[below right] at (-45:\Rz) {$B_2$};
  \node[below left] at (-135:\Rz) {$B_3$};
  \node[above left] at (135:\Rz) {$B_4$};
\end{tikzpicture}
