% Ракета и самолёт-мишень: мишень B летит горизонтально к пусковой установке O,
% в момент пуска расстояние OB = L. Угол линии визирования взят произвольным.
\begin{tikzpicture}[scale=1.3]
  \coordinate (O) at (0,0);
  \coordinate (B) at (3.4,2.1);
  \begin{scope}
    \clip (-0.9,-0.135) rectangle (4.2,0);
    \foreach \x in {-0.9,-0.73,...,4.505} \draw[thin] (\x,0) -- ++(-0.135,-0.135);
  \end{scope}
  \draw[standart] (-0.9,0) -- (4.2,0);
  \draw[thin, dashed] (-0.9,2.1) -- (4.2,2.1);
  \draw[thin, dashed] (O) -- node[above left] {$L$} (B);
  \draw[myarrow] (B) -- (2.3,2.1);
  \node[above=1pt] at ($(2.3,2.1)!1.4mm!(B)$) {$\mbfv$};
  \node[point] at (O) {};
  \node[point] at (B) {};
  \node[above left] at (O) {$O$};
  \node[above right] at (B) {$B$};
\end{tikzpicture}
