% Три тигра в вершинах прямоугольного равнобедренного треугольника (Всеросс 2022)
\begin{tikzpicture}[scale=1]
  \coordinate (A) at (0,0);
  \coordinate (B) at (3,0);
  \coordinate (C) at (3,3);
  \draw[myarrow] (-0.3,0) -- (3.9,0) node[below] {$x$};
  \draw[myarrow] (0,-0.3) -- (0,3.6) node[left] {$y$};
  \draw[standart] (A) -- (B) -- (C) -- cycle;
  \draw[myarrow] (A) -- ++(1.1,0) node[below] {$\mbfv_1$};
  \draw[myarrow] (B) -- ++(0,1.1) node[right] {$\mbfv_2$};
  \draw[myarrow] (C) -- ++(-0.9,-0.9) node[above left] {$\mbfv_3$};
  \node[point] at (A) {};
  \node[point] at (B) {};
  \node[point] at (C) {};
  \node[below left] at (A) {$A$};
  \node[below right] at (B) {$B$};
  \node[above right] at (C) {$C$};
\end{tikzpicture}
