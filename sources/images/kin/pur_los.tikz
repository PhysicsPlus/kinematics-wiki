% Линия визирования AB: скорости преследователя и цели, углы beta_A и beta_B
\begin{tikzpicture}[scale=1]
  \coordinate (A) at (0,0);
  \coordinate (B) at (5,1.5);
  \coordinate (B2) at ($(A)!1.3!(B)$);
  \coordinate (VA) at ($(A)+(46.7:1.7)$);
  \coordinate (VB) at ($(B)+(86.7:1.5)$);
  \draw[standart] (A) -- node[below right, pos=0.55] {$r$} (B);
  \draw[thin, dashed] (B) -- (B2);
  \draw[myarrow] (A) -- (VA) node[above left] {$\mbfv_A$};
  \draw[myarrow] (B) -- (VB) node[above] {$\mbfv_B$};
  \pic[draw, thin, pic text={$\beta_A$}, angle radius=9mm, angle eccentricity=1.35] {angle = B--A--VA};
  \pic[draw, thin, pic text={$\beta_B$}, angle radius=7mm, angle eccentricity=1.45] {angle = B2--B--VB};
  \node[point] at (A) {};
  \node[point] at (B) {};
  \node[below left] at (A) {$A$};
  \node[below right] at (B) {$B$};
\end{tikzpicture}
