% Линия визирования AB: скорости преследователя и цели, углы beta_A и beta_B
\begin{tikzpicture}[scale=1.5]
  \coordinate (A) at (0,0);
  \coordinate (B) at (5,1.5);
  \coordinate (B2) at ($(A)!1.3!(B)$);
  \coordinate (VA) at ($(A)+(46.7:1.7)$);
  \coordinate (VB) at ($(B)+(86.7:1.5)$);
  \draw[standart] (A) -- node[below right, pos=0.55] {$r$} (B);
  \draw[thin, dashed] (B) -- (B2);
  \draw[myarrow] (A) -- (VA);
  \node[left=1pt] at ($(VA)!1.4mm!(A)$) {$\mbfv_A$};
  \draw[myarrow] (B) -- (VB);
  \node[left=1pt] at ($(VB)!1.4mm!(B)$) {$\mbfv_B$};
  \pic[draw, thin, pic text={$\beta_A$}, angle radius=7mm, angle eccentricity=1.55] {angle = B--A--VA};
  \pic[draw, thin, pic text={$\beta_B$}, angle radius=3.5mm, angle eccentricity=2.5] {angle = B2--B--VB};
  \pic[draw, thin, angle radius=4.1mm] {angle = B2--B--VB};
  \node[point] at (A) {};
  \node[point] at (B) {};
  \node[below left] at (A) {$A$};
  \node[below right] at (B) {$B$};
\end{tikzpicture}
