% Погоня лисы за зайцем (u = 2v, L = 300 м, начальный угол 60 градусов) в системе зайца:
% начало в зайце, ось X вдоль его скорости, оси не вращаются; единица -- 100 м.
% Штриховые линии -- эллипсы r - X/2 = c(t) при t = 0, 8, 16, 22 с (c = 3,75; 2,55; 1,35; 0,45);
% сплошная -- рассчитанная численно траектория лисы. Точки -- положения лисы в эти моменты.
\begin{tikzpicture}[scale=0.95]
  \begin{scope}
    \clip (-3.2,-3.3) rectangle (2.4,2.2);
    \draw[thin, dashed] plot[domain=0:360, samples=120, smooth, variable=\t] ({3.75/(1-0.5*cos(\t))*cos(\t)}, {3.75/(1-0.5*cos(\t))*sin(\t)});
    \draw[thin, dashed] plot[domain=0:360, samples=120, smooth, variable=\t] ({2.55/(1-0.5*cos(\t))*cos(\t)}, {2.55/(1-0.5*cos(\t))*sin(\t)});
    \draw[thin, dashed] plot[domain=0:360, samples=120, smooth, variable=\t] ({1.35/(1-0.5*cos(\t))*cos(\t)}, {1.35/(1-0.5*cos(\t))*sin(\t)});
    \draw[thin, dashed] plot[domain=0:360, samples=120, smooth, variable=\t] ({0.45/(1-0.5*cos(\t))*cos(\t)}, {0.45/(1-0.5*cos(\t))*sin(\t)});
  \end{scope}
  \draw[myarrow] (-3.2,0) -- (2.7,0) node[below] {$X$};
  \draw[myarrow] (0,-3.3) -- (0,2.4) node[left] {$Y$};
  \draw[thick] plot[smooth] coordinates {(-1.500,-2.598) (-1.499,-2.495) (-1.496,-2.392) (-1.492,-2.291) (-1.485,-2.191) (-1.477,-2.093) (-1.467,-1.995) (-1.455,-1.899) (-1.441,-1.805) (-1.425,-1.712) (-1.407,-1.620) (-1.388,-1.531) (-1.366,-1.443) (-1.343,-1.356) (-1.317,-1.272) (-1.290,-1.190) (-1.261,-1.109) (-1.230,-1.031) (-1.197,-0.955) (-1.162,-0.881) (-1.126,-0.810) (-1.088,-0.741) (-1.048,-0.675) (-1.006,-0.611) (-0.962,-0.550) (-0.918,-0.492) (-0.871,-0.437) (-0.823,-0.385) (-0.774,-0.335) (-0.723,-0.289) (-0.671,-0.246) (-0.618,-0.207) (-0.563,-0.170) (-0.508,-0.137) (-0.452,-0.108) (-0.394,-0.082) (-0.337,-0.059) (-0.278,-0.040) (-0.219,-0.025) (-0.160,-0.013) (-0.100,-0.005) (-0.040,-0.001) (-0.005,-0.000)};
  \foreach \p/\lab/\pos in {{(-1.5,-2.598)}/{$t = 0$}/left, {(-1.335,-1.328)}/{$8$~с}/left, {(-0.839,-0.402)}/{$16$~с}/left, {(-0.298,-0.046)}/{$22$~с}/above left} {
    \node[point] at \p {};
    \node[\pos=1pt, font=\footnotesize] at \p {\lab};
  }
  \node[point] at (0,0) {};
  \node[above right] at (0,0) {$H$};
\end{tikzpicture}
