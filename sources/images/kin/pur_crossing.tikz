% Переправа: пункты A и B на противоположных берегах реки шириной l, течение со скоростью u.
\begin{tikzpicture}[scale=1.3]
  \coordinate (A) at (0,0);
  \coordinate (B) at (0,3);
  \begin{scope}
    \clip (-1.8,-0.135) rectangle (2.1,0);
    \foreach \x in {-1.8,-1.63,...,2.405} \draw[thin] (\x,0) -- ++(-0.135,-0.135);
  \end{scope}
  \begin{scope}
    \clip (-1.8,3) rectangle (2.1,3.135);
    \foreach \x in {-1.935,-1.765,...,2.27} \draw[thin] (\x,3) -- ++(0.135,0.135);
  \end{scope}
  \draw[standart] (-1.8,0) -- (2.1,0);
  \draw[standart] (-1.8,3) -- (2.1,3);
  \draw[thin, dashed] (A) -- (B);
  \draw[myarrow] (-1.5,1.5) -- (-0.5,1.5) node[above] {$u$};
  \draw[{Stealth[inset=0pt, length=8pt, angle'=30]}-{Stealth[inset=0pt, length=8pt, angle'=30]}, line width=0.75pt]
    (1.3,0) -- node[right] {$l$} (1.3,3);
  \node[point] at (A) {};
  \node[point] at (B) {};
  \node[above right] at (A) {$A$};
  \node[below right] at (B) {$B$};
\end{tikzpicture}
