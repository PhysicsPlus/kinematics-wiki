% Переправа: лодка C движется относительно воды со скоростью 2u, перпендикулярной BC.
% l = 3, течение вправо; положение лодки C взято на её траектории.
\begin{tikzpicture}[scale=1.3]
  \coordinate (A) at (0,0);
  \coordinate (B) at (0,3);
  \coordinate (C) at (-1.524,1.05);
  \foreach \x in {-3.1,-2.8,...,2.5} {
    \draw[thin] (\x,0) -- ++(-0.18,-0.18);
    \draw[thin] (\x,3) -- ++(0.18,0.18);
  }
  \draw[standart] (-3.2,0) -- (2.6,0);
  \draw[standart] (-3.2,3) -- (2.6,3);
  \draw[thin, dashed] (A) -- (B);
  \draw[thin, dashed] (B) -- (C);
  \draw[myarrow] (1.1,1.6) -- (2.2,1.6) node[above] {$u$};
  \draw[myarrow] (C) -- ++(-0.985,0.770) node[left] {$2u$};
  \draw[thin] (-1.682,1.173) -- (-1.559,1.331) -- (-1.401,1.208);
  \draw[thin] (0.3,0) -- (0.9,0);
  \draw[thin] (0.3,3) -- (0.9,3);
  \draw[{Stealth[inset=0pt, length=8pt, angle'=30]}-{Stealth[inset=0pt, length=8pt, angle'=30]}, line width=0.75pt]
    (0.75,0) -- node[right] {$l$} (0.75,3);
  \node[point] at (A) {};
  \node[point] at (B) {};
  \node[point] at (C) {};
  \node[above right] at (A) {$A$};
  \node[below right] at (B) {$B$};
  \node[below right] at (C) {$C$};
\end{tikzpicture}
