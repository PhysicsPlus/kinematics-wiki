% Конькобежцы на концентрических дорожках (R1 = 2, R2 = 1) бегут в противоположные стороны
% с равными периодами. Слева -- лабораторная система; справа -- система, движущаяся
% поступательно вместе с первым конькобежцем (оси не вращаются): траектория второго -- эллипс
% с полуосями R1 - R2 (вдоль начального радиуса) и R1 + R2.
\begin{tikzpicture}[scale=0.95]
  \begin{scope}
    \draw[standart] (0,0) circle (2);
    \draw[standart] (0,0) circle (1);
    \draw[thin] (0,0) -- (2,0);
    \coordinate (S1) at (2,0);
    \coordinate (S2) at (1,0);
    \draw[myarrow] (S1) -- ++(0,0.8);
    \draw[myarrow] (S2) -- ++(0,-0.8);
    \node[right=1pt] at ($(2,0.8)!1.4mm!(S1)$) {$\mbfv_1$};
    \node[left=1pt] at ($(1,-0.8)!1.4mm!(S2)$) {$\mbfv_2$};
    \node[point] at (0,0) {};
    \node[point] at (S1) {};
    \node[point] at (S2) {};
    \node[below left] at (0,0) {$O$};
    \node[below right] at (S1) {$1$};
    \node[above left] at (S2) {$2$};
    \node at (0,-3.6) {а)};
  \end{scope}
  \begin{scope}[xshift=7.4cm]
    \draw[myarrow] (-1.6,0) -- (1.9,0) node[below] {$X$};
    \draw[myarrow] (0,-3.4) -- (0,3.5) node[left] {$Y$};
    \draw[thick] (0,0) ellipse (1 and 3);
    \draw[myarrow] ({-cos(40)},{-3*sin(40)}) -- ({-cos(47)},{-3*sin(47)});
    \draw[thin] (0,-3) -- (-2.0,-3);
    \draw[thin] (0,3) -- (-2.0,3);
    \draw[{Stealth[inset=0pt, length=8pt, angle'=30]}-{Stealth[inset=0pt, length=8pt, angle'=30]}, line width=0.75pt] (-1.85,-3) -- node[left] {$2(R_1 + R_2)$} (-1.85,3);
    \node[point] at (0,0) {};
    \node[point] at (-1,0) {};
    \node[above right] at (0,0) {$1$};
    \node[below left] at (-1,0) {$2$};
    \node at (0,-4.2) {б)};
  \end{scope}
\end{tikzpicture}
