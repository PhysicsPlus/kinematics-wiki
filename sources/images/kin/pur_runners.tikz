% Спортсмены на пересекающихся тропинках: A бежит под углом alpha к AB, B -- вдоль BA
\begin{tikzpicture}[scale=1.5]
  \coordinate (A) at (0,0);
  \coordinate (B) at (5,0);
  \coordinate (P) at (35:2.25);
  \draw[thin, dashed] (A) -- (P);
  \draw[thin, dashed] (A) -- (B);
  \draw[myarrow] (A) -- (35:1.3);
  \node[above left=0pt] at ($(35:1.3)!1.4mm!(A)$) {$\mbfv_A$};
  \draw[myarrow] (B) -- (3.7,0);
  \node[above=1pt] at ($(3.7,0)!1.4mm!(B)$) {$\mbfv_B$};
  \pic[draw, thin, pic text={$\alpha$}, angle radius=7mm, angle eccentricity=1.4] {angle = B--A--P};
  \draw[thin] (A) -- (0,-0.55);
  \draw[thin] (B) -- (5,-0.55);
  \draw[{Stealth[inset=0pt, length=8pt, angle'=30]}-{Stealth[inset=0pt, length=8pt, angle'=30]}, line width=0.75pt]
    (0,-0.42) -- node[above] {$L$} (5,-0.42);
  \node[point] at (A) {};
  \node[point] at (B) {};
  \node[left] at (A) {$A$};
  \node[right] at (B) {$B$};
\end{tikzpicture}
