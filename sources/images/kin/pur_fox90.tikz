% Лиса бежит со скоростью u = 3v под прямым углом к направлению на зайца (L = 1).
% а) Лабораторная система: заяц H идёт по оси x, лиса F описывает петлистую кривую
% (полтора периода); штрихами соединены одновременные положения в моменты 0, T/2, T.
% б) Система зайца (начало в H, оси не вращаются): эллипс 3r - Y = 4L с фокусами
% H = (0,0) и H' = (0,L), центр (0, L/2), полуоси sqrt(2) L и 3L/2.
\begin{tikzpicture}[scale=0.85]
  % ---- а) лабораторная система
  \begin{scope}
    \draw[thin] (-1.1,0) -- (5.6,0);
    \draw[thick] plot[smooth] coordinates {(0.000,-1.000) (-0.165,-0.982) (-0.323,-0.928) (-0.465,-0.842) (-0.588,-0.730) (-0.687,-0.596) (-0.763,-0.448) (-0.814,-0.290) (-0.841,-0.125) (-0.847,0.041) (-0.832,0.207) (-0.798,0.370) (-0.748,0.529) (-0.682,0.682) (-0.602,0.828) (-0.511,0.967) (-0.408,1.098) (-0.296,1.221) (-0.175,1.336) (-0.046,1.441) (0.090,1.538) (0.231,1.626) (0.378,1.704) (0.530,1.773) (0.685,1.833) (0.844,1.884) (1.005,1.926) (1.169,1.958) (1.334,1.981) (1.500,1.995) (1.666,2.000) (1.833,1.995) (1.999,1.981) (2.164,1.958) (2.327,1.926) (2.488,1.884) (2.647,1.833) (2.802,1.773) (2.954,1.704) (3.101,1.626) (3.242,1.538) (3.378,1.441) (3.507,1.336) (3.628,1.221) (3.740,1.098) (3.843,0.967) (3.935,0.828) (4.014,0.682) (4.080,0.529) (4.130,0.370) (4.164,0.207) (4.179,0.041) (4.173,-0.125) (4.146,-0.290) (4.095,-0.448) (4.020,-0.596) (3.920,-0.730) (3.797,-0.842) (3.655,-0.928) (3.497,-0.982) (3.332,-1.000) (3.167,-0.982) (3.010,-0.928) (2.867,-0.842) (2.744,-0.730) (2.645,-0.596) (2.569,-0.448) (2.518,-0.290) (2.491,-0.125) (2.486,0.041) (2.501,0.207) (2.534,0.370) (2.585,0.529) (2.650,0.682) (2.730,0.828) (2.821,0.967) (2.924,1.098) (3.036,1.221) (3.157,1.336) (3.286,1.441) (3.422,1.538) (3.564,1.626) (3.711,1.704) (3.862,1.773) (4.017,1.833) (4.176,1.884) (4.337,1.926) (4.501,1.958) (4.666,1.981) (4.832,1.995) (4.998,2.000)};
    \foreach \x/\y in {0/-1, 1.666/2, 3.332/-1} {
      \draw[thin, dashed] (\x,0) -- (\x,\y);
      \node[point] at (\x,0) {};
      \node[point] at (\x,\y) {};
    }
    \draw[myarrow] (0,0) -- (0.6,0);
    \node[below=1pt] at ($(0.6,0)!1.4mm!(0,0)$) {$\mbfv$};
    \draw[myarrow] (0,-1) -- (-1.1,-1);
    \node[below=1pt] at ($(-1.1,-1)!1.4mm!(0,-1)$) {$\mbfu$};
    \node[above right] at (0,0) {$H_0$};
    \node[below right] at (0,-1) {$F_0$};
    \node at (2.2,-1.75) {а)};
  \end{scope}
  % ---- б) система зайца
  \begin{scope}[xshift=8.3cm]
    \draw[myarrow] (-2.1,0) -- (2.3,0) node[below] {$X$};
    \draw[myarrow] (0,-1.5) -- (0,2.6) node[left] {$Y$};
    \draw[thick] (0,0.5) ellipse ({sqrt(2)} and 1.5);
    \draw[thick, -{Stealth[inset=0pt, length=7pt, angle'=30]}]
      plot[domain=-100:-128, samples=12, smooth, variable=\t] ({sqrt(2)*cos(\t)}, {0.5+1.5*sin(\t)});
    \coordinate (P) at (1.2,1.294);
    \draw[thin] (0,0) -- node[below right=-2pt] {$r$} (P);
    \draw[thin] (0,1) -- node[above=-1pt] {$r'$} (P);
    \node[point] at (0,0) {};
    \node[point] at (0,1) {};
    \node[point] at (0,-1) {};
    \node[point] at (0,2) {};
    \node[point] at (P) {};
    \node[below left] at (0,0) {$H$};
    \node[left] at (0,1) {$H'$};
    \node[below right] at (0,-1) {$F_0$};
    \node[above right] at (P) {$F$};
    \node at (0.1,-1.75) {б)};
  \end{scope}
\end{tikzpicture}
